# Build output. Nothing generated is committed: the game server deploys from a
# PUBLISHED RELEASE and downloads its assets, so the built package and the
# generated releases.json are uploaded by tools/release.sh, never tracked. A
# generated file in git is a generated file someone can ship by mistake.
build/
releases/
.output

# macOS
.DS_Store

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Local working notes: design plans and cross-repo handoffs that are not part
# of the package. Listed by name so a new source file can never be ignored by
# accident - tools/release.sh refuses to cut a release from an unclean tree,
# and an untracked planning doc must not be what stops it.
UI_Command_Plan.md
GMCP_Journal_Request.md
MDW_Bootstrap_Handoff.md
RELEASE_DEPLOY_HANDOFF.md
